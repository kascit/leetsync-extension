{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeetSync Config",
  "type": "object",
  "properties": {
    "version": { "type": "integer" },
    "repo": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "defaultBranch": { "type": "string" }
      },
      "required": ["owner", "name"]
    },
    "queue": {
      "type": "object",
      "properties": {
        "branch": { "type": "string" },
        "path": { "type": "string" },
        "maxPerRun": { "type": "integer" }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "dir": { "type": "string" },
        "includeDate": { "type": "boolean" },
        "includeStatus": { "type": "boolean" }
      }
    },
    "readme": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["incremental", "ac", "all"] }
      }
    },
    "pr": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "autoMerge": { "type": "boolean" },
        "mergeMethod": {
          "type": "string",
          "enum": ["squash", "merge", "rebase"]
        },
        "titleTemplate": { "type": "string" },
        "bodyTemplate": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "path": { "type": "string" }
      }
    }
  }
}
